# Copy to .env.local and fill in ONE of these. Without a key the assistant runs in offline (rule-based) mode.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional
# LLM_PROVIDER=gemini          # claude | gemini | off  (default: first key that is set, Claude first)
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash
