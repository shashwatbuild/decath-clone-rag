# Copy to .env.local and fill in ONE of these. Without a key the assistant runs in offline (rule-based) mode.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional
# LLM_PROVIDER=gemini          # claude | gemini | off  (default: first key that is set, Claude first)
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash

# Durable community-fit storage on Vercel (Upstash Redis Marketplace integration).
# Vercel's KV_REST_API_URL / KV_REST_API_TOKEN names are also supported.
# These are server-only credentials. Never prefix them with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional local semantic retrieval (requires Ollama + an installed embedding model).
# After installing the model, build the index with:
# RAG_EMBEDDINGS=ollama npm run index:rag
# Then enable the following in .env.local and restart Next.js:
# RAG_EMBEDDINGS=ollama
# RAG_EMBEDDING_MODEL=embeddinggemma
# RAG_EMBEDDING_URL=http://127.0.0.1:11434/api/embed
# RAG_VECTOR_INDEX=.local/rag-vectors.json
